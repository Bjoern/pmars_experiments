+
+static int enter(expr_parser *p)
+{
+  if (p->error || p->depth >= EVAL_MAX_DEPTH || ++p->steps > EVAL_MAX_STEPS) {
+    if (!p->error) p->error = BAD_EXPR;
+    return FALSE;
+  }
