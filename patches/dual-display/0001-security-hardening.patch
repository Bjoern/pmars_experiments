+static long number(expr_parser *p, int negative)
+{
+  unsigned long value = 0;
+  unsigned long limit = (unsigned long)LONG_MAX + (negative ? 1UL : 0UL);
+  while (isdigit((unsigned char)*p->cur)) {
+    unsigned int digit = (unsigned int)(*p->cur++ - '0');
